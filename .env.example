# Ollama OpenAI-compatible API endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama

# Candidate model to benchmark (e.g. phi4-mini:3.8b, qwen2.5:3b, llama3.2:3b)
MODEL_NAME=phi4-mini:3.8b

# Comma-separated sampling temperatures to benchmark
TEMPERATURES=0.0,0.7

# Max self-healing retry reprompts per test case on schema validation failure
MAX_RETRIES=2

# Offline LLM-as-a-Judge model for response quality evaluation
EVAL_MODEL=hf.co/flowaicom/Flow-Judge-v0.1-GGUF:Q4_K_M
